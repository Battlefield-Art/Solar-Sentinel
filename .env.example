# Solar-Sentinel-AIO v3 - Environment variables
# Copy to `.env` and edit. Never commit your real secrets.

# MQTT broker credentials (CHANGE THESE)
MQTT_USER=solar
MQTT_PASS=change-me-strong-password

# InfluxDB organization + admin user for first-boot onboarding
INFLUXDB_ORG=my-org
INFLUX_ADMIN_USER=solar
# Leave empty to auto-generate on first boot
INFLUX_ADMIN_PASSWORD=

# Grafana admin password (CHANGE THIS)
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana

# Gemini API key (Hermes AI agent)
GEMINI_API_KEY=

# Electricity rate for waste analysis (USD/kWh)
ELECTRICITY_RATE_USD_PER_KWH=0.15

# Weather source. Leave as the compose network URL for the optional
# self-hosted open-meteo service, or set to the public API:
# OPEN_METEO_URL=https://api.open-meteo.com
OPEN_METEO_URL=http://open-meteo:8080

# Notifications
NTFY_URL=https://ntfy.sh/solar_sentinel_guard_alerts
